case "$ACTION" in
	wps-connected)
		uci set network.wan.ifname=$INTERFACE
		uci commit
		state=$(uci get system.@system[0].state)
		[ "$state" = "config_complete" ] || {
			local ifaddr=
			local suffix=
			STATE=config_started /etc/statemgr >> /dev/null
			ifaddr=$(cat /sys/class/net/$INTERFACE/address)
			suffix=${ifaddr#"00:03:7f:"}
			uci set system.@system[0].friendly_name="New Skifta-$suffix"
			uci set system.@system[0].hostname="New Skifta-$suffix"
			uci commit
			STATE=config_friendly_name /etc/statemgr >> /dev/null
			STATE=config_complete /etc/statemgr >> /dev/null
			uci set system.@system[0].state='config_complete'
			uci commit
			ubus call network reload
		}
		ubus call network.interface.wan down
		ubus call network.interface.wan up
	;;

esac

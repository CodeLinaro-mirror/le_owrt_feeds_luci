--- a/applications/luci-dock/Makefile
+++ b/applications/luci-dock/Makefile
@@ -0,0 +1,4 @@
+PO = dock
+
+include ../../build/config.mk
+include ../../build/module.mk
--- a/applications/luci-dock/luasrc/controller/dock.lua
+++ b/applications/luci-dock/luasrc/controller/dock.lua
@@ -0,0 +1,14 @@
+module("luci.controller.dock", package.seeall)
+
+function index()
+    if not nixio.fs.access("/etc/config/dock") then
+	    return
+    end
+
+    local page
+
+    page = node("admin", "network", "dock")
+    page.target = cbi("dock")
+    page.title  = _("Wireless Dock")
+    page.order  = 25
+end
--- a/applications/luci-dock/luasrc/model/cbi/dock.lua
+++ b/applications/luci-dock/luasrc/model/cbi/dock.lua
@@ -0,0 +1,61 @@
+--[[
+LuCI - Lua Configuration Interface
+
+Copyright (c) 2015 Qualcomm Atheros, Inc.
